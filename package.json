{
  "name": "dsh-usage-kline",
  "version": "1.1.0",
  "type": "module",
  "description": "DeepSeek usage terminal: a stock-terminal style K-line panel for usage, spend and balance",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.3",
    "title": {
      "zh": "鐢ㄩ噺琛屾儏",
      "en": "Usage terminal"
    },
    "icon": "chart",
    "contributes": {
      "composer.strip": [
        {
          "id": "today",
          "icon": "chart",
          "panel": "usage"
        }
      ],
      "panels": [
        {
          "id": "usage",
          "title": {
            "zh": "鐢ㄩ噺琛屾儏",
            "en": "Usage"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}

