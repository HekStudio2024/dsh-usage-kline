{
  "name": "dsh-usage-kline",
  "version": "1.0.1",
  "type": "module",
  "description": "DeepSeek usage terminal: a stock-terminal style K-line panel for usage, spend and balance",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "billing",
    "kline"
  ],
  "homepage": "https://hekstudio2024.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HekStudio2024/dsh-usage-kline.git"
  },
  "bugs": {
    "url": "https://github.com/HekStudio2024/dsh-usage-kline/issues"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
